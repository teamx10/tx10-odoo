<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="solar_ai.ModelSelectWidget">
        <div class="o_solar_ai_model_select">
            <input
                t-ref="input"
                type="text"
                t-att-class="{ 'o_input': true, 'is-invalid': state.invalid }"
                t-att-value="state.query"
                t-att-placeholder="props.placeholder or 'anthropic/claude-sonnet-4-5'"
                t-att-disabled="props.readonly"
                t-on-input="onInput"
                t-on-focus="onFocus"
                t-on-blur="onBlur"
            />

            <t t-if="state.isOpen and groups.length">
                <div class="o_solar_ai_model_dropdown">
                    <t t-foreach="groups" t-as="group" t-key="group[0]">
                        <div class="o_solar_ai_model_group_header" t-esc="group[0]"/>
                        <t t-foreach="group[1]" t-as="model" t-key="model.id">
                            <div
                                class="o_solar_ai_model_item"
                                t-att-class="{ o_selected: model.id === state.query }"
                                t-on-mousedown.prevent="() => onSelect(model.id)"
                            >
                                <span class="o_solar_ai_model_name" t-esc="model.name"/>
                                <span class="o_solar_ai_model_id" t-esc="model.id"/>
                                <span class="o_solar_ai_model_price" t-esc="formatPrice(model)"/>
                            </div>
                        </t>
                    </t>
                </div>
            </t>

            <t t-if="state.loading">
                <span class="o_solar_ai_model_hint">Loading models…</span>
            </t>
            <t t-elif="state.invalid">
                <span class="o_solar_ai_model_hint text-danger">Виберіть модель зі списку</span>
            </t>
            <t t-elif="state.error">
                <span class="o_solar_ai_model_hint text-danger" t-esc="state.error"/>
            </t>
            <t t-elif="currentModel">
                <span class="o_solar_ai_model_hint">
                    <t t-esc="formatPrice(currentModel)"/> per 1M tokens
                </span>
            </t>
        </div>
    </t>
</templates>
