# iSolar Demo — environment variables
# Copy to .env (gitignored) and adjust before docker compose up
# These values are safe defaults for local demo only — change for any shared/production use.

DB_PASSWORD=odoo

# Master password for the Odoo database manager. The manager is disabled by
# default (list_db = False in docker/odoo.conf), so this is unused out of the
# box. Only relevant if you re-enable list_db and add `admin_passwd` to
# odoo.conf yourself — never pass it on the command line (leaks via docker inspect).
ADMIN_PASSWD=admin

# OpenRouter API key — leave empty to run iSolar without AI features
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=
