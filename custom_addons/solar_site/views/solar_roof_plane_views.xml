<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone form for roof plane (used when opened directly) -->
    <record id="view_solar_roof_plane_form" model="ir.ui.view">
        <field name="name">solar.roof.plane.form</field>
        <field name="model">solar.roof.plane</field>
        <field name="arch" type="xml">
            <form string="Roof Plane">
                <sheet>
                    <group>
                        <group>
                            <field name="solar_site_id"/>
                            <field name="name"/>
                            <field name="orientation"/>
                            <field name="pitch_degrees"/>
                        </group>
                        <group>
                            <field name="total_area_m2"/>
                            <field name="usable_area_m2"/>
                            <field name="shading_risk"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
