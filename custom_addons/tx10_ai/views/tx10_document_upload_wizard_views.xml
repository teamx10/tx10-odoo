<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard form view -->
    <record id="view_tx10_document_upload_wizard_form" model="ir.ui.view">
        <field name="name">tx10.document.upload.wizard.form</field>
        <field name="model">tx10.document.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Завантажити документи">
                <field name="state" invisible="1"/>
                <sheet>
                    <!-- Upload step -->
                    <group invisible="state != 'upload'">
                        <field name="project_id"/>
                        <field name="attachment_ids" widget="many2many_binary" string="Файли"/>
                    </group>

                    <!-- Done step — summary table -->
                    <group invisible="state != 'done'">
                        <field name="project_id" readonly="1"/>
                    </group>
                    <field name="result_line_ids" invisible="state != 'done'">
                        <list decoration-warning="status == 'needs_review'"
                              decoration-danger="status == 'error'"
                              decoration-muted="status == 'skipped'">
                            <field name="filename"/>
                            <field name="folder_id"/>
                            <field name="confidence" string="Confidence" widget="float"/>
                            <field name="status"/>
                            <field name="message"/>
                        </list>
                    </field>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'done' or not has_needs_review">
                        Деякі файли потребують ручної перевірки
                    </div>
                </sheet>
                <footer>
                    <button string="Класифікувати" type="object" name="action_classify_and_file"
                            class="btn-primary" invisible="state != 'upload'"/>
                    <button string="Закрити" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_tx10_document_upload_wizard" model="ir.actions.act_window">
        <field name="name">Завантажити документи</field>
        <field name="res_model">tx10.document.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>

    <!-- Button on project.project form -->
    <record id="view_project_project_tx10_upload_button" model="ir.ui.view">
        <field name="name">project.project.tx10.upload.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(tx10_ai.action_tx10_document_upload_wizard)d"
                        icon="fa-upload">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Загрузити документи</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Inherit solar.document list to add folder column -->
    <record id="view_solar_document_list_tx10_folder" model="ir.ui.view">
        <field name="name">solar.document.list.tx10.folder</field>
        <field name="model">solar.document</field>
        <field name="inherit_id" ref="solar_project.view_solar_document_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='document_type_id']" position="after">
                <field name="folder_id" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
