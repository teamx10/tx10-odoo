<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_tx10_document_folder_tree" model="ir.ui.view">
        <field name="name">tx10.document.folder.tree</field>
        <field name="model">tx10.document.folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="folder_code"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_tx10_document_folder_form" model="ir.ui.view">
        <field name="name">tx10.document.folder.form</field>
        <field name="model">tx10.document.folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="parent_id"/>
                        <field name="folder_code"/>
                        <field name="complete_name"/>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <field name="document_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="ai_classified"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tx10_document_folder" model="ir.actions.act_window">
        <field name="name">Document Folders</field>
        <field name="res_model">tx10.document.folder</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_project_id': active_id}</field>
        <field name="domain">[('project_id', '=', active_id)]</field>
    </record>

    <!-- Smart button on project.project form -->
    <record id="view_project_project_tx10_folders_button" model="ir.ui.view">
        <field name="name">project.project.tx10.folders.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(tx10_ai.action_tx10_document_folder)d"
                        icon="fa-folder-open">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Папки</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
